#!/bin/bash

pull_repo() {
  local path="$1"
  shift

  echo -e "\nPulling $(basename "$path")..."

  cd "$path" || exit
  if ! git pull; then
    echo -e "\033[31mFailed to pull $(basename "$path")\033[0m"
    exit 1
  fi

  if [ "$#" -gt 0 ]; then
    "$@"
  fi
}

pull_repo "$HOME/Install" ./INSTALL.sh

while IFS= read -r -d '' repo; do
  if git -C "$repo" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    pull_repo "$repo"
  fi
done < <(find "$HOME/Projects" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

echo
omarchy plugin update

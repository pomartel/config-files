#!/bin/bash
set -euo pipefail

download_only=false
case "${1:-}" in
  "") ;;
  --download-only) download_only=true ;;
  *)
    echo "Usage: $0 [--download-only]" >&2
    exit 2
    ;;
esac

# Find the newest issue currently present instead of assuming that the next
# Saturday's edition has already been uploaded.
repository_contents="$(
  curl \
    --fail \
    --location \
    --retry 3 \
    --retry-all-errors \
    --silent \
    --show-error \
    'https://api.github.com/repos/hehonghui/awesome-english-ebooks/contents/01_economist?ref=master'
)"
issue_slug="$(
  jq --exit-status --raw-output \
    '[.[] | select(.type == "dir") | .name | select(test("^te_[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"))] | max | sub("^te_"; "")' \
    <<< "$repository_contents"
)"
issue_date="${issue_slug//./-}"

today="$(date +%F)"
today_epoch="$(date --utc --date "$today" +%s)"
issue_epoch="$(date --utc --date "$issue_date" +%s)"
issue_age_days="$(( (today_epoch - issue_epoch) / 86400 ))"

if (( issue_age_days > 6 )); then
  alert_subject="Economist download aborted: latest issue is $issue_age_days days old"
  alert_body="The newest Economist EPUB in hehonghui/awesome-english-ebooks is dated $issue_date. It is $issue_age_days days old, so the download was aborted. Check whether the repository is still being updated."

  echo "$alert_body" >&2

  if [[ "$download_only" == true ]]; then
    echo "Notification email suppressed in --download-only mode." >&2
    exit 1
  fi

  calibre-smtp \
    --relay "email-smtp.us-east-1.amazonaws.com" \
    --port "587" \
    --username "$SES_SMTP_USERNAME" \
    --password "$SES_SMTP_PASSWORD" \
    --encryption-method "TLS" \
    --subject "$alert_subject" \
    "pomartel@coderubik.com" \
    "po@pouding.com" \
    "$alert_body"

  exit 1
fi

epub="$HOME/Dropbox/Books/Economist/the-economist-$issue_date.epub"
source_url="https://raw.githubusercontent.com/hehonghui/awesome-english-ebooks/master/01_economist/te_$issue_slug/TheEconomist.$issue_slug.epub"
partial="$epub.part"

mkdir -p "$(dirname "$epub")"
trap 'rm -f "$partial"' EXIT

echo "Downloading The Economist $issue_date from GitHub..."
curl \
  --fail \
  --location \
  --retry 3 \
  --retry-all-errors \
  --show-error \
  --output "$partial" \
  "$source_url"

unzip -tqq "$partial"
mv "$partial" "$epub"
trap - EXIT

echo "Saved $epub"

if [[ "$download_only" == true ]]; then
  exit 0
fi

calibre-smtp \
  --relay "email-smtp.us-east-1.amazonaws.com" \
  --port "587" \
  --username "$SES_SMTP_USERNAME" \
  --password "$SES_SMTP_PASSWORD" \
  --encryption-method "TLS" \
  --subject "The Economist $issue_date" \
  --attachment "$epub" \
  "pomartel@coderubik.com" \
  "monkindleamoi@kindle.com" \
  "Automated delivery from Calibre."

#!/usr/bin/env bash

set -euo pipefail

HDMI="HDMI-A-1"
PROJECTOR_PROFILE="projector"
LAPTOP_PROFILE="laptop-only"

if ! command -v hyprmoncfg >/dev/null 2>&1; then
    notify-send "hyprmoncfg is not installed"
    exit 1
fi

monitors=$(hyprctl -j monitors all)
if ! jq -e --arg output "$HDMI" 'any(.[]; .name == $output)' <<<"$monitors" >/dev/null; then
    notify-send "No HDMI monitor detected"
    exit 0
fi

if jq -e --arg output "$HDMI" \
    'any(.[]; .name == $output and .mirrorOf != null and .mirrorOf != "none")' \
    <<<"$monitors" >/dev/null; then
    target="$LAPTOP_PROFILE"
else
    target="$PROJECTOR_PROFILE"
fi

if ! hyprmoncfg apply "$target" --confirm-timeout 0; then
    notify-send "Could not apply hyprmoncfg profile: $target"
    exit 1
fi

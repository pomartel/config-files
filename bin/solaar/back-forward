#!/usr/bin/env bash
set -euo pipefail

button="${1:-back}"
window_class="$(hyprctl activewindow -j | jq -r '.class // ""' | tr '[:upper:]' '[:lower:]')"

case "$button" in
  back)
    browser_key="Left"
    terminal_key="Down"
    ;;
  forward)
    browser_key="Right"
    terminal_key="Up"
    ;;
  *)
    echo "usage: $0 [back|forward]" >&2
    exit 2
    ;;
esac

case "$window_class" in
  *foot* | *ghostty* | *alacritty* | *kitty* | *wezterm* | *terminator* | *xterm* | *urxvt* | *konsole*)
    wtype -M ctrl -k "$terminal_key" -m ctrl
    ;;
  *)
    wtype -M alt -k "$browser_key" -m alt
    ;;
esac

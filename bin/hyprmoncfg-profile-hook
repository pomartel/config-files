#!/usr/bin/env bash

set -euo pipefail

profile=${1:-}
if [[ -z "$profile" ]]; then
  # Give Hyprland a moment to finish disabling/activating outputs after reload.
  sleep 1
  monitors=$(hyprctl -j monitors all)
  if jq -e 'any(.[]; .name == "DP-1" and .disabled == false)' <<<"$monitors" >/dev/null; then
    profile=desk
  else
    profile=laptop-only
  fi
fi

case "$profile" in
  desk)
    gaps_out=10
    gaps_in=5
    ;;
  laptop-only|projector)
    gaps_out=3
    gaps_in=1
    ;;
  *)
    exit 0
esac

for workspace in {1..10}; do
  hyprctl eval "hl.workspace_rule({ workspace = \"$workspace\", gaps_out = $gaps_out, gaps_in = $gaps_in })"
done

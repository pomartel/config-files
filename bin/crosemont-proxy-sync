#!/usr/bin/bash

set -u

readonly PAC_URL="http://10.1.0.75/wpad.dat"
readonly PROXY_URL="http://10.1.0.5:8080"
readonly NO_PROXY_LIST="localhost,127.0.0.1,::1,.local,.crosemont.qc.ca,.cegepadistance.ca,10.0.0.0/8"
readonly ETHERNET_PROFILE="Ethernet automatique"

proxy_is_announced() {
  local device type state dhcp_options

  while IFS=: read -r device type state; do
    [[ "$type" == "ethernet" && "$state" == "connected" ]] || continue

    dhcp_options=$(nmcli -e no -g DHCP4.OPTION device show "$device" 2>/dev/null)

    if [[ "$dhcp_options" == *"wpad = $PAC_URL"* ]] \
      || [[ "$dhcp_options" == *"ip_address = 10.36.0."* \
        && "$dhcp_options" == *"domain_name = crosemont.qc.ca"* ]]; then
      return 0
    fi
  done < <(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null)

  return 1
}

enable_proxy() {
  nmcli connection modify "$ETHERNET_PROFILE" \
    proxy.method auto proxy.pac-url "$PAC_URL" proxy.browser-only no 2>/dev/null
  gsettings set org.gnome.system.proxy mode 'auto'
  gsettings set org.gnome.system.proxy autoconfig-url "$PAC_URL"
  systemctl --user set-environment \
    HTTP_PROXY="$PROXY_URL" HTTPS_PROXY="$PROXY_URL" \
    http_proxy="$PROXY_URL" https_proxy="$PROXY_URL" \
    NO_PROXY="$NO_PROXY_LIST" no_proxy="$NO_PROXY_LIST"
  echo "Crosemont proxy enabled ($PAC_URL)"
}

disable_proxy() {
  nmcli connection modify "$ETHERNET_PROFILE" \
    proxy.method none proxy.pac-url '' proxy.pac-script '' 2>/dev/null
  gsettings set org.gnome.system.proxy mode 'none'
  gsettings set org.gnome.system.proxy autoconfig-url ''
  systemctl --user unset-environment \
    HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY no_proxy
  echo "Crosemont proxy disabled"
}

sync_proxy() {
  if proxy_is_announced; then
    enable_proxy
  else
    disable_proxy
  fi
}

if [[ "${1:-}" != "--watch" ]]; then
  sync_proxy
  exit 0
fi

last_state=""
update_if_needed() {
  if proxy_is_announced; then
    current_state="enabled"
  else
    current_state="disabled"
  fi

  if [[ "$current_state" != "$last_state" ]]; then
    sync_proxy
    last_state="$current_state"
  fi
}

update_if_needed
while IFS= read -r _; do
  sleep 1
  update_if_needed
done < <(LC_ALL=C stdbuf -oL nmcli monitor 2>/dev/null)
